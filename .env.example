# Copy to .env for local public configuration. Do not put seed phrases or
# private keys in this file.

CLUSTER=devnet
# Backward-compatible alias. Prefer CLUSTER.
# SOLANA_CLUSTER=devnet

# Optional custom RPC URL. Leave empty to use the cluster default.
RPC_URL=

OWNER_KEYPAIR=./keys/owner.json
MINT_KEYPAIR=./keys/mint-academyprime-token.json

# Solana addresses are base58. The digit 0 is invalid, so literal 350M is
# impossible. Use a valid suffix such as 35M, 35, or 35oM.
VANITY_SUFFIX=35M
MAX_VANITY_ATTEMPTS=5000000

TOKEN_NAME=Academy Prime
TOKEN_SYMBOL=ACAD-P
TOKEN_DESCRIPTION=Academy Prime in the new and innovation way to learn about Crypto, The token taking over by the community. As a community we Believe This project is awesome and graten, a fixed-supply Solana meme token.
TOKEN_LOGO_URI=https://i.ibb.co/jkWJKPL6/ACAD-P.png
TOKEN_METADATA_URI=https://scarlet-capable-hedgehog-259.mypinata.cloud/ipfs/bafkreiefenleer3r7c7qwyhrp4mt7wkvg4opgebifrbqyjccmf6cta4p6q
TOKEN_EXTERNAL_URL=https://linktr.ee/100academy
TOKEN_SUPPLY=1000000
TOKEN_DECIMALS=6

# Mainnet guard. Keep false unless you are intentionally deploying to mainnet.
CONFIRM_MAINNET=false
REVOKE_AFTER_MINT=true

